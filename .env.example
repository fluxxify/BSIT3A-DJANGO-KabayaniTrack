# KabayaniTrack environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (no spaces). Example:
# DJANGO_ALLOWED_HOSTS=Fluxxify.pythonanywhere.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=Fluxxify.pythonanywhere.com

# Comma-separated list of CSRF trusted origins (include https://). Example:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://Fluxxify.pythonanywhere.com,http://localhost:8000
DJANGO_CSRF_TRUSTED_ORIGINS=https://Fluxxify.pythonanywhere.com

# Public base URL used in outbound email (login warnings, alerts).
SITE_BASE_URL=https://Fluxxify.pythonanywhere.com

# --- Security (production) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# --- Email (Gmail SMTP on PythonAnywhere free tier) ---
# Get a 16-character Gmail App Password: myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com
EMAIL_TIMEOUT=10

# Password reset token expiry (seconds). Default: 3600 (1 hour).
PASSWORD_RESET_TIMEOUT=3600

# --- Nemotron 3.5 Super (NVIDIA) text LLM integration ---
# Optional AI features: concern auto-categorisation, welfare triage, portal chatbot.
# Get an API key from https://build.nvidia.com/  (free tier available).
# Leave blank to disable AI features; staff fill fields by hand instead.
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super
NVIDIA_API_TIMEOUT=20
